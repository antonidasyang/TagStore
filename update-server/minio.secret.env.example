# TagStore update publishing — MinIO credentials.
#
# SETUP:
#   1. Copy this file to "minio.secret.env" in the same folder.
#   2. Fill in MINIO_ACCESS_KEY and MINIO_SECRET_KEY with your upload keys.
#
# "minio.secret.env" is gitignored and must NEVER be committed.
# Both publish.ps1 (Windows) and publish.sh (bash) read it automatically and
# run `mc alias set` for you, so you never type the keys on the command line.
#
# Format: KEY=value  (no spaces around '=', no quotes needed).

# NOTE: upload and download use DIFFERENT URLs.
#   MINIO_ENDPOINT  = where this machine PUSHES files (internal, direct MinIO).
#   MINIO_BASE_URL  = the public URL written into latest.json for END USERS to
#                     download from. These are not the same host.

# --- Required: UPLOAD endpoint + the access/secret key pair ------------------
# Shared upload account "downloads-app" — read/write on the `downloads` bucket
# ONLY. Endpoint + secret are in docs/软件发布上传指南.md; copy the secret into
# your local minio.secret.env. Use the LAN endpoint on the company network
# (faster), or the public HTTPS one from anywhere.
MINIO_ENDPOINT=http://10.6.1.211:9000
# MINIO_ENDPOINT=https://oss.d2ssoft.com   # public, works from any network
MINIO_ACCESS_KEY=downloads-app
MINIO_SECRET_KEY=

# --- Optional overrides (defaults shown) -------------------------------------
MINIO_ALIAS=d2s
# Shared bucket; each product lives in its own subfolder (downloads/<product>/...).
MINIO_BUCKET=downloads
MINIO_PRODUCT=tagstore
# Public DOWNLOAD base URL baked into latest.json (what the app fetches).
MINIO_BASE_URL=https://oss.d2ssoft.com/downloads/tagstore
