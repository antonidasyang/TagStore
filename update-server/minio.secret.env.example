# TagStore update publishing — MinIO credentials.
#
# SETUP:
#   1. Copy this file to "minio.secret.env" in the same folder.
#   2. Fill in MINIO_ACCESS_KEY and MINIO_SECRET_KEY with your upload keys.
#
# "minio.secret.env" is gitignored and must NEVER be committed.
# Both publish.ps1 (Windows) and publish.sh (bash) read it automatically and
# run `mc alias set` for you, so you never type the keys on the command line.
#
# Format: KEY=value  (no spaces around '=', no quotes needed).

# --- Required: endpoint + the access/secret key pair used to UPLOAD ----------
MINIO_ENDPOINT=https://oss.d2ssoft.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Optional overrides (defaults shown) -------------------------------------
MINIO_ALIAS=d2s
MINIO_BUCKET=tagstore-updates
MINIO_BASE_URL=https://oss.d2ssoft.com/tagstore-updates
